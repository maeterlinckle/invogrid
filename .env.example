# ---------------------------------------------------------------------------
# InvoGrid — copy this file to .env and fill in real values. Never commit .env.
#
# Anything an administrator edits day to day lives in the `settings` table and
# is managed from Settings in the application. The values here are the ones a
# server needs before the database can be read at all, plus fallbacks for the
# integration credentials.
#
# Precedence: a non-empty value in `settings` wins; the .env value below is the
# fallback used when the setting has not been filled in.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="InvoGrid"
APP_ENV=production            # local | production
APP_DEBUG=false               # true only on a development machine
APP_URL=https://invogrid.example.com
APP_TIMEZONE=Europe/London
APP_CURRENCY=GBP
APP_CURRENCY_SYMBOL="£"

# Encryption key for the secrets that have to live in the database — the
# Paperless token, the Clear Books OAuth2 client secret and tokens, the OpenAI
# and Anthropic API keys, and the webhook shared secret. It is also the session
# secret: session identifiers are bound to it.
#
# Generate one with `php bin/console.php key:generate`.
# Changing it makes every stored secret unreadable; they would have to be
# re-entered in Settings. Back it up with the database, not instead of it.
APP_KEY=

# --- Database --------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=invogrid
DB_USERNAME=invogrid
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Sessions and security -------------------------------------------------
SESSION_NAME=invogrid_session
SESSION_LIFETIME=240          # minutes of inactivity before the session expires
SESSION_SAMESITE=Lax          # Lax | Strict
FORCE_HTTPS=true              # redirect http -> https and set the Secure cookie flag
TRUST_PROXY=true              # honour X-Forwarded-Proto/For from the reverse proxy

# Login throttling
LOGIN_MAX_ATTEMPTS=5          # failed attempts before lockout
LOGIN_DECAY_MINUTES=15        # window the attempts are counted over
LOGIN_LOCKOUT_MINUTES=15      # how long an account/IP stays locked out

# Password policy. Applied identically by bin/create-admin.php, the users
# screen and the change-your-own-password page.
PASSWORD_MIN_LENGTH=12        # characters
PASSWORD_MIN_CLASSES=3        # of: lower case, upper case, numbers, symbols

# The most one PDF fetched from Paperless may write to disk. The transfer is
# aborted the moment it goes over, so a misconfiguration cannot fill the volume.
MAX_PDF_BYTES=104857600       # 100 MB

# --- Storage ---------------------------------------------------------------
# Downloaded PDFs, rendered page images, uploaded logos and the application log.
# Relative to the project root, or an absolute path.
STORAGE_PATH=storage

# --- Integrations (fallbacks; normally set in Settings) ---------------------
# Paperless-ngx v3
PAPERLESS_BASE_URL=
PAPERLESS_TOKEN=

# The shared secret a Paperless workflow must present to the webhook receiver.
INVOGRID_WEBHOOK_SECRET=

# Clear Books (OAuth2 + business id; not a static API key)
CLEARBOOKS_BASE_URL=https://api.clearbooks.co.uk
CLEARBOOKS_CLIENT_ID=
CLEARBOOKS_CLIENT_SECRET=
CLEARBOOKS_BUSINESS_ID=

# LLM providers — both are supported and selected per pipeline stage in Settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- External tools --------------------------------------------------------
# PDF page rendering. Imagick (with Ghostscript behind it) is used when the
# extension is present; otherwise pdftoppm from poppler-utils is shelled out.
# Leave blank to look the binary up on PATH.
PDFTOPPM_PATH=
